mixin sprite(id, title)
  svg(role="img" title=title)&attributes(attributes)
    use(href=`${assetPath("/img/icons.svg")}#${id}`)

mixin postPreview(post)
  a(href=getUrl(`/${post.permalink}`, lang)).post-preview&attributes(attributes)
    if post.previewImage
      img(src=assetPath(post.previewImage) alt=post.title)
    header
      small.date= displayDate(post.date)
      h3= post.title

//- Inline video with a big centred play button. Pair with /js/video-play.js.
mixin videoWithPlay(src, poster)
  .video-with-play&attributes(attributes)
    video(controls preload="metadata" poster=poster)
      source(src=src type="video/mp4")
      | Your browser does not support the video tag.
    button.video-play-button(type="button" aria-label=i18n('video.play', lang))
      //- No aria-hidden: elements.css hides [aria-hidden='true'] globally.
      //- The button's aria-label already covers the icon for screen readers.
      svg(viewBox="0 0 24 24" role="presentation" focusable="false")
        path(d="M6.5 5v14l12-7z")

//- Standard YouTube player in a responsive 16:9 frame. Uses the nocookie host,
//- which is the same player without the tracking cookies.
mixin youtubeEmbed(videoId, title)
  .video-embed&attributes(attributes)
    //- referrerpolicy is required: the site is served with
    //- `Referrer-Policy: same-origin`, which strips the Referer on cross-origin
    //- requests. Without a referrer YouTube can't identify the embedding domain
    //- and the player fails with "Error 153: Video player configuration error".
    //- This overrides the document policy for this request only, and sends the
    //- origin alone (https://peachbitcoin.com/), never the full path.
    iframe(
      src=`https://www.youtube-nocookie.com/embed/${videoId}`
      title=title
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    )

mixin navItem(id, title)
  a(href=getUrl(`/${id}/`, lang) class=(permalink === id && 'current'))&attributes(attributes)= title

mixin map(id, markers)
  .vectorMap(id=id)
  script.
    const markers = [!{markers}];
    // https://jvectormap.com/documentation/javascript-api/jvm-map/
    new jvm.MultiMap({
      container: $(`#!{id}`),
      main: {
        map: 'world_mill',
        backgroundColor: 'transparent',
        markers,
        focusOn: ['DE', 'GB', 'ES', 'PL', 'PO', 'IT', 'NL', 'BE', 'GR', 'CY'],
        regionStyle: {
          initial: {
            'fill': 'var(--color-map-region)',
            'stroke': 'var(--color-map-outline)',
            'stroke-width': .25
          },
          hover: {
            'fill-opacity': .8,
            cursor: 'pointer'
          }
        },
        onMarkerClick(event, index) {
          const marker = markers[index]
          if (marker.url) window.open(marker.url, '_blank');
        }
      },
      mapUrlByCode(code, multiMap) {
        return `/vendor/jvectormap/maps/${code.toLowerCase()}_${multiMap.defaultProjection}.js`;
      },
      mapNameByCode(code, multiMap) {
        return `${code.toLowerCase()}_${multiMap.defaultProjection}`;
      }
    });
